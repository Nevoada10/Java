# ------------------------------------------------------------
# 6. ASSIGN USERS TO GROUPS
# ------------------------------------------------------------

# Assignment of users to groups

dn: cn=Managers,ou=Groups,ou=Managers,dc=cku,dc=local
changetype: modify
add: memberUid
memberUid: manager1
memberUid: manager2

dn: cn=Waiters,ou=Groups,ou=Waiters,dc=cku,dc=local
changetype: modify
add: memberUid
memberUid: waiter1
memberUid: waiter2
memberUid: waiter3
memberUid: waiter4
memberUid: waiter5

dn: cn=Customers,ou=Groups,ou=Customers,dc=cku,dc=local
changetype: modify
add: memberUid
memberUid: customer1
memberUid: customer2
memberUid: customer3
memberUid: customer4
memberUid: customer5
memberUid: customer6
memberUid: customer7
memberUid: customer8
memberUid: customer9
memberUid: customer10
memberUid: customer11
memberUid: customer12
memberUid: customer13
memberUid: customer14