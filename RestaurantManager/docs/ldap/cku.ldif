# ============================================================
# CKU Restaurant LDAP Structure
# Base DN: dc=cku,dc=local
# Description: Complete LDAP structure for CKU Restaurant management system (Copy of real)
# ============================================================


# ------------------------------------------------------------
# 1. ORGANIZATIONAL UNITS
# ------------------------------------------------------------

dn: ou=General,dc=cku,dc=local
objectClass: organizationalUnit
objectClass: top
ou: General

dn: ou=Customers,dc=cku,dc=local
objectClass: organizationalUnit
objectClass: top
ou: Customers

dn: ou=Users,ou=Customers,dc=cku,dc=local
objectClass: organizationalUnit
objectClass: top
ou: Users

dn: ou=Groups,ou=Customers,dc=cku,dc=local
objectClass: organizationalUnit
objectClass: top
ou: Groups

dn: ou=Managers,dc=cku,dc=local
objectClass: organizationalUnit
objectClass: top
ou: Managers

dn: ou=Users,ou=Managers,dc=cku,dc=local
objectClass: organizationalUnit
objectClass: top
ou: Users

dn: ou=Groups,ou=Managers,dc=cku,dc=local
objectClass: organizationalUnit
objectClass: top
ou: Groups

dn: ou=Waiters,dc=cku,dc=local
objectClass: organizationalUnit
objectClass: top
ou: Waiters

dn: ou=Users,ou=Waiters,dc=cku,dc=local
objectClass: organizationalUnit
objectClass: top
ou: Users

dn: ou=Groups,ou=Waiters,dc=cku,dc=local
objectClass: organizationalUnit
objectClass: top
ou: Groups


# ------------------------------------------------------------
# 2. GROUPS
# ------------------------------------------------------------

dn: cn=Managers,ou=Groups,ou=Managers,dc=cku,dc=local
objectClass: posixGroup
objectClass: top
cn: Managers
gidNumber: 1000

dn: cn=Waiters,ou=Groups,ou=Waiters,dc=cku,dc=local
objectClass: posixGroup
objectClass: top
cn: Waiters
gidNumber: 1001

dn: cn=Customers,ou=Groups,ou=Customers,dc=cku,dc=local
objectClass: posixGroup
objectClass: top
cn: Customers
gidNumber: 1002

# ------------------------------------------------------------
# 3. MANAGERS
