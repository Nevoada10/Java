CustomerService ..> Customer
LdapUserRepositoryProduction ..> User
LdapUserRepositoryProduction ..> Manager
LdapUserRepositoryProduction ..> Waiter
LdapUserRepositoryProduction ..> Customer

ReservationManager ..> JdbcTablesRepository
ReservationManager ..> JdbcReservationsRepository
ReservationManager ..> JdbcOrdersRepository
ReservationManager ..> JdbcDishRepository
ReservationManager ..> JdbcMenusRepository
ReservationManager *-- Reservation

WaiterService ..> ReservationManager
WaiterService ..> JdbcOrdersRepository
WaiterService ..> JdbcReservationsRepository
WaiterService ..> JdbcDishRepository
WaiterService ..> JdbcMenusRepository
WaiterService ..> LdapUserRepositoryProduction

' JDBC dependencies
JdbcTablesRepository ..> Table
JdbcReservationsRepository ..> Reservation
JdbcReservationsRepository ..> Table
JdbcDishRepository ..> Dish
JdbcDishRepository ..> Allergen
JdbcDishRepository ..> Category
JdbcMenusRepository ..> Menu
JdbcMenusRepository ..> Dish
JdbcOrdersRepository ..> Order
JdbcOrdersRepository ..> OrderItem
JdbcOrdersRepository ..> Table
JdbcOrdersRepository ..> Dish
JdbcOrdersRepository ..> Menu

' UI dependencies
Main ..> CustomerConsole
Main ..> ManagerConsole
Main ..> WaiterConsole
Main ..> ReservationManager
Main ..> CustomerService
Main ..> LdapUserRepositoryProduction

CustomerConsole ..> ReservationManager
CustomerConsole ..> LdapUserRepositoryProduction
CustomerConsole ..> ConsoleUi

ManagerConsole ..> ReservationManager
ManagerConsole ..> WaiterService
ManagerConsole ..> ConsoleUi

WaiterConsole ..> WaiterService
WaiterConsole ..> ReservationManager
WaiterConsole ..> ConsoleUi

legend left
  Inheritance: --|>
  Dependency: ..>
  Association: -->
  Composition: *--
endlegend

@enduml
