"BasicT": {
	"prefix": "basict",
	"body": [
		"package onlineShop;",
		"",
		"public class BasicT extends TShirt {",
		"",
		"\tprivate boolean hasPocket;",
		"\tprivate boolean hasButtons;",
		"",
		"\tpublic BasicT(String barCode, String desc, Fabric fabric, Color color,",
		"\t\t\t\tboolean hasPocket, boolean hasButtons) {",
		"\t\tsuper(barCode, desc, fabric, color);",
		"\t\tthis.hasPocket = hasPocket;",
		"\t\tthis.hasButtons = hasButtons;",
		"\t\tsetPrice(price());",
		"\t}",
		"",
		"\t@Override",
		"\tpublic float price() {",
		"\t\tfloat total = 10;",
		"\t\ttotal += super.price();",
		"",
		"\t\tif (hasPocket) {",
		"\t\t\ttotal += 2;",
		"\t\t}",
		"\t\tif (hasButtons) {",
		"\t\t\ttotal += 3;",
		"\t\t}",
		"",
		"\t\treturn total;",
		"\t}",
		"",
		"\tpublic boolean isHasPocket() {",
		"\t\treturn hasPocket;",
		"\t}",
		"",
		"\tpublic void setHasPocket(boolean hasPocket) {",
		"\t\tthis.hasPocket = hasPocket;",
		"\t}",
		"",
		"\tpublic boolean isHasButtons() {",
		"\t\treturn hasButtons;",
		"\t}",
		"",
		"\tpublic void setHasButtons(boolean hasButtons) {",
		"\t\tthis.hasButtons = hasButtons;",
		"\t}",
		"",
		"\t@Override",
		"\tpublic String toString() {",
		"\t\treturn super.toString()",
		"\t\t\t\t+ String.format(\" %-10s %-5s %-5s\",",
		"\t\t\t\tgetFabric(), hasPocket, hasButtons);",
		"\t}",
		"}"
	],
	"description": "BasicT class"
},

