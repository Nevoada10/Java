"Product": {
	"prefix": "product",
	"body": [
		"package onlineShop;",
		"",
		"public abstract class Product {",
		"",
		"\tprivate String barCode;",
		"\tprivate String desc;",
		"\tprivate float price = 0;",
		"\tprivate PrintImage printImage = null;",
		"\tprivate Color color;",
		"\tprivate boolean onSell = true;",
		"",
		"\tpublic Product(String barCode, String desc, Color color) {",
		"\t\tthis.barCode = barCode;",
		"\t\tthis.desc = desc;",
		"\t\tthis.color = color;",
		"\t}",
		"",
		"\tpublic abstract float price();",
		"",
		"\tpublic String getBarCode() {",
		"\t\treturn barCode;",
		"\t}",
		"",
		"\tpublic void setBarCode(String barCode) {",
		"\t\tthis.barCode = barCode;",
		"\t}",
		"",
		"\tpublic String getDesc() {",
		"\t\treturn desc;",
		"\t}",
		"",
		"\tpublic void setDesc(String desc) {",
		"\t\tthis.desc = desc;",
		"\t}",
		"",
		"\tpublic float getPrice() {",
		"\t\treturn price;",
		"\t}",
		"",
		"\tpublic void setPrice(float price) {",
		"\t\tthis.price = price;",
		"\t}",
		"",
		"\tpublic PrintImage getPrintImage() {",
		"\t\treturn printImage;",
		"\t}",
		"",
		"\tpublic void setPrintImage(PrintImage printImage) {",
		"\t\tthis.printImage = printImage;",
		"\t}",
		"",
		"\tpublic Color getColor() {",
		"\t\treturn color;",
		"\t}",
		"",
		"\tpublic void setColor(Color color) {",
		"\t\tthis.color = color;",
		"\t}",
		"",
		"\tpublic boolean isOnSell() {",
		"\t\treturn onSell;",
		"\t}",
		"",
		"\tpublic void setOnSell(boolean onSell) {",
		"\t\tthis.onSell = onSell;",
		"\t}",
		"",
		"\t@Override",
		"\tpublic String toString() {",
		"\t\tString print = (printImage == null) ? \"NULL\" : printImage.name();",
		"\t\treturn String.format(\"%-6s %-8s %-6.2f %-10s %-6s %-5s\",",
		"\t\t\t\tbarCode, desc, price, print, color, onSell);",
		"\t}",
		"}"
	],
	"description": "Product abstract class"
},

