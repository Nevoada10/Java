	"OnlineShop": {
	"prefix": "shop",
	"body": [
		"package onlineShop;",
		"",
		"import java.util.ArrayList;",
		"import java.util.List;",
		"",
		"public class OnlineShop {",
		"",
		"\tprivate List<Product> stock;",
		"",
		"\tpublic OnlineShop() {",
		"\t\tstock = new ArrayList<>();",
		"\t}",
		"",
		"\tpublic boolean addProduct(Product p) {",
		"\t\treturn stock.add(p);",
		"\t}",
		"",
		"\tpublic boolean removeProduct(Product p) {",
		"\t\treturn stock.remove(p);",
		"\t}",
		"",
		"\tpublic boolean sellProduct(Product p, PrintImage printImage) {",
		"\t\tif (p.isOnSell()) {",
		"\t\t\tp.setPrintImage(printImage);",
		"\t\t\tp.setPrice(p.getPrice() + 10);",
		"\t\t\treturn removeProduct(p);",
		"\t\t}",
		"\t\treturn false;",
		"\t}",
		"",
		"\tpublic float stockValue() {",
		"\t\tfloat total = 0;",
		"\t\tfor (Product p : stock) {",
		"\t\t\ttotal += p.getPrice();",
		"\t\t}",
		"\t\treturn total;",
		"\t}",
		"",
		"\tpublic String listStock() {",
		"\t\tString header = String.format(\"%-6s %-8s %-6s %-10s %-6s %-5s %-10s %-5s %-5s %-7s\",",
		"\t\t\t\t\"BARCODE\", \"DESC\", \"PRICE\", \"PRINT\", \"COLOR\", \"ON-SELL\",",
		"\t\t\t\t\"FABRIC\", \"POCKET?\", \"BUTTONS?\", \"CAP TYPE\");",
		"\t\tString line = \"-\".repeat(80);",
		"",
		"\t\tStringBuilder sb = new StringBuilder();",
		"\t\tsb.append(header).append(\"\\n\");",
		"\t\tsb.append(line).append(\"\\n\");",
		"",
		"\t\tfor (Product p : stock) {",
		"\t\t\tsb.append(p.toString()).append(\"\\n\");",
		"\t\t}",
		"",
		"\t\treturn sb.toString();",
		"\t}",
		"",
		"\tpublic int numCaps() {",
		"\t\tint count = 0;",
		"\t\tfor (Product p : stock) {",
		"\t\t\tif (p instanceof Cap) {",
		"\t\t\t\tcount++;",
		"\t\t\t}",
		"\t\t}",
		"\t\treturn count;",
		"\t}",
		"",
		"\tpublic int numTShirts() {",
		"\t\tint count = 0;",
		"\t\tfor (Product p : stock) {",
		"\t\t\tif (p instanceof TShirt) {",
		"\t\t\t\tcount++;",
		"\t\t\t}",
		"\t\t}",
		"\t\treturn count;",
		"\t}",
		"",
		"\tpublic List<Product> getStock() {",
		"\t\treturn stock;",
		"\t}",
		"",
		"\tpublic void setStock(List<Product> stock) {",
		"\t\tthis.stock = stock;",
		"\t}",
		"}"
	],
	"description": "OnlineShop class"
},

